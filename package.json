{
  "name": "monad-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MonadMCP \u2014 AI agent identity & wallet infrastructure on Monad (MCP + Privy + viem)",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:server": "node init && pnpm --filter @monad-mcp/mcp-server dev",
    "dev:dashboard": "node init && pnpm --filter @monad-mcp/dashboard dev",
    "build": "node init && pnpm -r build",
    "build:server": "node init && pnpm --filter @monad-mcp/mcp-server build",
    "build:dashboard": "node init && pnpm --filter @monad-mcp/dashboard build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @monad-mcp/mcp-server test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
