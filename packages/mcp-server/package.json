{
  "name": "@monad-mcp/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MonadMCP server — MCP tools giving AI agents a secure wallet on Monad",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@privy-io/server-auth": "^1.32.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "viem": "^2.56.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "eslint": "^10.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.3"
  }
}
