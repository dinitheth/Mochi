# Privy — get from https://dashboard.privy.io
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
# Optional: hex private key for local-dev signer fallback (0x...). Used only when Privy is not configured.
# DEV_PRIVATE_KEY=
# Optional: pre-provisioned agent address (read-only mode when no signer available)
# AGENT_ADDRESS=

# Monad
MONAD_NETWORK=testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Security — human-in-the-loop
SPENDING_LIMIT_WEI=1000000000000000000
APPROVAL_WEBHOOK_URL=http://localhost:3001/api/approvals
APPROVAL_POLL_TIMEOUT_MS=300000
# Number of distinct dashboard approvers required for gated actions (1-10).
APPROVAL_QUORUM=1
# Use the same random token in the MCP server and dashboard environments.
APPROVAL_API_TOKEN=replace_with_a_long_random_value
# Dashboard sign-in password and session signing secret (dashboard environment).
DASHBOARD_PASSWORD=replace_with_a_strong_password
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_value

# Server transport
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3002
# Required when MCP_TRANSPORT=http or --http is used. Use a long random bearer token.
MCP_API_TOKEN=
# Optional remote OAuth for ChatGPT. Keep the client secret private and configure the same values on the server.
MCP_PUBLIC_URL=https://mcp.getmochi.dev
MCP_OAUTH_RESOURCE=https://mcp.getmochi.dev/mcp
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
# Public user sign-in via Cognito (configured by deploy/aws-stack.yaml).
COGNITO_ISSUER_URL=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=https://mcp.getmochi.dev/oauth/identity/callback
# Optional: only this verified Cognito email inherits the existing legacy `owner` wallet.
COGNITO_LEGACY_OWNER_EMAIL=

# Optional: Nansen / Zerion for NFT & token research
NANSEN_API_KEY=
ZERION_API_KEY=

# DeFi: 0x API for mainnet swaps (https://dashboard.0x.org)
OX_API_KEY=
# Uniswap Trading API for Monad mainnet v4 quotes/swaps
UNISWAP_API_KEY=
# OpenSea public API key (Monad listings discovery; https://docs.opensea.io)
OPENSEA_API_KEY=
# Override the testnet MicroSwap pool (defaults to the deployed pool)
MICROSWAP_POOL_ADDRESS=

# Envio: HyperRPC reads + HyperSync history (https://envio.dev/app/api-tokens)
HYPER_RPC_URL=
HYPERSYNC_URL=https://monad-testnet.hypersync.xyz
HYPERSYNC_TOKEN=
